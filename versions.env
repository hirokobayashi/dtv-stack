# versions.env — pinned sources for all build dependencies.
#
# Each dependency is two lines:
#   "# renovate: depName=<owner/repo> branch=<branch>"  -> parsed by Renovate
#   <PREFIX>_REF=<40-hex sha> <PREFIX>_BRANCH=<branch>   -> sourced by workflows/scripts
#
# Renovate (renovate.json) raises PRs that bump <PREFIX>_REF to the branch head.
# Workflows must never clone without checking out $PREFIX_REF.
#
# Generated 2026-10-25 from GitHub API (branch heads at that date).

# renovate: depName=tsukumijima/EDCB branch=master
EDCB_REF=119ff765fb3989a2e7b6187717420fdaad550657 EDCB_BRANCH=master  # 2026-10-16
